# Multi-Provider LLM API Keys (comma-separated for multiple keys)
# Provider order: Gemini -> DeepSeek -> OpenAI -> Groq -> Together AI
# Copy this file to .env and fill in your API keys

# Environment Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Local Model Flag - When true, uses Ollama locally, when false uses cloud models
LOCAL_MODEL=false

# Ollama Configuration (used when LOCAL_MODEL=true)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct

# Gemini API Keys (used when LOCAL_MODEL=false)
GEMINI_API_KEYS=your_gemini_key1,your_gemini_key2,your_gemini_key3

# DeepSeek API Keys (used when LOCAL_MODEL=false)
DEEPSEEK_API_KEYS=your_deepseek_key1,your_deepseek_key2,your_deepseek_key3

# OpenAI API Keys (used when LOCAL_MODEL=false)
OPENAI_API_KEYS=your_openai_key1,your_openai_key2,your_openai_key3,your_openai_key4

# Groq API Keys (used when LOCAL_MODEL=false)
GROQ_API_KEYS=your_groq_key1,your_groq_key2,your_groq_key3,your_groq_key4

# Together AI API Keys (used when LOCAL_MODEL=false)
TOGETHER_API_KEYS=your_together_key1,your_together_key2

# Port
PORT=5000
