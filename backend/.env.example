GEMINI_API_KEYS=api1, api2, api3
# OpenRouter API Keys - Fallback when Gemini fails (qwen/qwen3-coder:free)
OPENROUTER_API_KEYS=your_openrouter_key1,your_openrouter_key2,your_openrouter_key34

PORT=5000

# Local Model Flag - When true, uses Ollama locally, when false uses cloud models
LOCAL_MODEL=false

# Ollama Configuration (used when LOCAL_MODEL=true)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct

NODE_ENV=development
FRONTEND_URL=http://localhost:5173
